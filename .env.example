# Server Configuration
PORT=3000
NODE_ENV=development

# Google Workspace API Credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Key-Here\n-----END PRIVATE KEY-----"
GOOGLE_ADMIN_USER_EMAIL=admin@techflow.com

# Slack API Credentials
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Firebase / Cloud Firestore Configuration
FIREBASE_PROJECT_ID=identityflow-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@identityflow-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Key-Here\n-----END PRIVATE KEY-----"

# EmailJS Configuration
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=public_key_xxxxxxx
EMAILJS_PRIVATE_KEY=private_key_xxxxxxx
